  m_Script: {fileID: 11500000, guid: 1e4742977594419498a45801cf12dbd4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PopupContenido
  instIngredientes:
    titulo: Guardado de alimentos
    texto: "Almacen\xE1 cada alimento en el lugar correspondiente."
    imagen: {fileID: 614017651250292314, guid: 98682f698076ddb4cafe20c894318213, type: 3}
  fbIngredientesCorrectos:
    titulo: "\xA1Muy bien!"
    texto: "\xA1Muy bien! Todos los ingredientes fueron almacenados correctamente."
    imagen: {fileID: 2993095752457197746, guid: 6aa6eb039ee823045996d1e8abb3c1d0, type: 3}
  fbIngredientesIncorrectos:
    titulo: "Revis\xE1 la organizaci\xF3n"
    texto: Hay ingredientes almacenados en lugares incorrectos.
    imagen: {fileID: 2993095752457197746, guid: 6aa6eb039ee823045996d1e8abb3c1d0, type: 3}
  instLavadoVerduras:
    titulo: Lavado de verduras
    texto: Asegurate de lavar correctamente las verduras para quitarles la suciedad.
    imagen: {fileID: 0}
  fbLavadoVerduras:
    titulo: "\xA1Verduras limpias!"
    texto: "\xA1Excelente! Todas las verduras quedaron limpias y listas para cortar."
    imagen: {fileID: 0}
  instLavado:
    titulo: Lavado de manos
    texto: Lavate las manos antes de comenzar a manipular los alimentos.
    imagen: {fileID: 2196400052816904958, guid: 260a8a45222952941b8c61ab3b03e519, type: 3}
  fbLavado:
    titulo: "\xA1Lavado completado!"
    texto: "\xA1Muy bien! Completaste correctamente el lavado de manos."
    imagen: {fileID: 7243696176584207193, guid: 921920767bd1cc444a633475b157a3cf, type: 3}
  instCortado:
    titulo: Cortar los ingredientes
    texto: "Us\xE1 el cuchillo para cortar el ingrediente siguiendo los puntos de
      corte."
    imagen: {fileID: 6551152255779376774, guid: 6a862b50e53d0a449a984720cdd8dada, type: 3}
  fbCortado:
    titulo: "\xA1Buen trabajo!"
    texto: "\xA1Buen trabajo! Completaste correctamente el corte de los ingredientes."
    imagen: {fileID: -6590363398050559408, guid: 4c75e87845e0e4841bd40c46d1b4532b, type: 3}
  fbCortadoContaminado:
    titulo: "\xA1Cuidado!"
    texto: "Se produjo contaminaci\xF3n cruzada durante el cortado de los alimentos."
    imagen: {fileID: -6590363398050559408, guid: 4c75e87845e0e4841bd40c46d1b4532b, type: 3}
  instCoccion:
    titulo: "Cocci\xF3n"
    texto: "Coloc\xE1 la carne sobre la hornalla y control\xE1 el indicador de cocci\xF3n."
    imagen: {fileID: -6590363398050559408, guid: 4c75e87845e0e4841bd40c46d1b4532b, type: 3}
  fbCarneCorrecta:
    titulo: "\xA1Cocci\xF3n perfecta!"
    texto: "\xA1Excelente! La carne alcanz\xF3 el punto de cocci\xF3n adecuado."
    imagen: {fileID: -5932461725324412915, guid: 039b76ff0105efd408b1de656ff7be92, type: 3}
  fbCarneCruda:
    titulo: "Cocci\xF3n incompleta"
    texto: "La carne qued\xF3 cruda."
    imagen: {fileID: -5932461725324412915, guid: 039b76ff0105efd408b1de656ff7be92, type: 3}
  fbCarneQuemada:
    titulo: "Cocci\xF3n incorrecta"
    texto: "La carne se quem\xF3."
    imagen: {fileID: -5932461725324412915, guid: 039b76ff0105efd408b1de656ff7be92, type: 3}
  instEmplatado:
    titulo: Emplatado
    texto: "Coloc\xE1 los ingredientes en el plato siguiendo el orden indicado."
    imagen: {fileID: -6590363398050559408, guid: 4c75e87845e0e4841bd40c46d1b4532b, type: 3}
  fbEmplatado:
    titulo: "\xA1Plato terminado!"
    texto: "\xA1Plato terminado! Completaste correctamente la preparaci\xF3n."
    imagen: {fileID: 0}
